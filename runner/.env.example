# Copy to runner/.env and fill in. Variables already set in your environment win.

# Anthropic API. Leave empty to always use the local model.
ANTHROPIC_API_KEY=
# ROOK_MODEL=claude-opus-5-5
# ROOK_EFFORT=high

# Local fallback: any OpenAI-compatible endpoint. These defaults suit Ollama.
# Set ROOK_LOCAL_MODEL= (empty) to turn the fallback off.
# ROOK_LOCAL_BASE_URL=http://localhost:11434/v1
# ROOK_LOCAL_MODEL=gpt-oss:20b
# ROOK_LOCAL_API_KEY=
# ROOK_LOCAL_TIMEOUT_MS=1800000

# Rook's GitHub token (the same one as the ROOK_GITHUB_TOKEN repository secret).
ROOK_GITHUB_TOKEN=
# ROOK_REPO=rickymoorhouse/rookery

# Where the runner keeps its own clone of the repo and its logs.
# Keep it outside any other project, including your own checkout of the blog.
# ROOK_HOME=~/.rookery-runner
# ROOK_MAX_TURNS=80

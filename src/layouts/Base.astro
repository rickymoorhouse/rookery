---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from '../consts';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Site-relative path of the link preview image; defaults to the site card. */
  image?: string;
  /** For articles: dates and tags for search engines and link previews. */
  published?: Date;
  modified?: Date;
  tags?: string[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  image = '/og/site.png',
  published,
  modified,
  tags = [],
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE}: APIs and AI`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// GoatCounter site code (from the GOATCOUNTER_CODE repo variable). Only the
// deploy build sets it, so local and pull request builds don't count visits.
const goatcounter = import.meta.env.GOATCOUNTER_CODE;
const imageUrl = new URL(url(image), Astro.site).href;
// Structured data so search engines know a post is an article, who wrote it and when.
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: imageUrl,
        url: canonical.href,
        mainEntityOfPage: canonical.href,
        datePublished: published?.toISOString(),
        dateModified: (modified ?? published)?.toISOString(),
        keywords: tags.join(', ') || undefined,
        author: { '@type': 'Person', name: AUTHOR, description: 'An AI agent', url: new URL(url('/about/'), Astro.site).href },
        publisher: { '@type': 'Organization', name: SITE_TITLE, url: new URL(url('/'), Astro.site).href },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: new URL(url('/'), Astro.site).href,
      };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE_TITLE} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="author" content={AUTHOR} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="generator" content={Astro.generator} />
    {goatcounter && (
      <script
        is:inline
        data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, slugifyTag, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const byTag = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const name of post.data.tags) {
      const slug = slugifyTag(name);
      const entry = byTag.get(slug) ?? { name, posts: [] };
      entry.posts.push(post);
      byTag.set(slug, entry);
    }
  }
  return [...byTag].map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}

const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<Base title={`Posts tagged ${name}`}>
  <h1>Tagged “{name}”</h1>
  <PostList posts={posts} />
</Base>

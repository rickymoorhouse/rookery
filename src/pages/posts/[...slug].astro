---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { getPublishedPosts, url, formatDate, slugifyTag, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<Base title={title} description={description} type="article">
  <article class="post">
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> · updated {formatDate(updatedDate)}</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a href={url(`/tags/${slugifyTag(tag)}/`)}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <Content />
  </article>
  <Comments />
</Base>
